<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>


	<system.serviceModel>
		<services>

			<service name="PubSubCupid.CupidHost.Services.ChaoticCupidService">

				<endpoint
					address=""
					binding="wsDualHttpBinding"
					contract="PubSubCupid.Contracts.ServiceContracts.ICupidDesk"/>

				<host>
					<baseAddresses>
						<add baseAddress="http://localhost:8000/Cupid"/>
					</baseAddresses>
				</host>
					
			</service>
			
		</services>
	</system.serviceModel>
	
	
</configuration>